# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES (MONGODB ATLAS & VERCEL)
# ==============================================================================
# Instructions:
# 1. In Vercel Project Settings > Environment Variables, add the variables below.
# 2. For local testing, copy this file to .env and fill in your real credentials.
# 3. NEVER commit your real .env file or credentials to Git.
# ==============================================================================

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas > Database > Connect > Drivers (Node.js)
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Optional: MongoDB database name (defaults to "portfolio" if omitted)
MONGODB_DB_NAME=portfolio

# Secret key used for signing / verifying session tokens (at least 32 random characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: Secret token for one-time initialization via API (/api/setup/init)
# Only needed if you prefer web setup over the CLI script (node scripts/create-owner.js)
ADMIN_SETUP_TOKEN=

# Node Environment ("development" locally, "production" on Vercel)
NODE_ENV=production

